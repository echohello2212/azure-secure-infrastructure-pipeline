# Terraform working directory (downloaded providers, regenerable with init)
.terraform/

# State files: contain resource IDs (!may hold secrets in plain text!)
*.tfstate
*.tfstate.*

# Variable files: where real values are entered
*.tfvars
*.tfvars.json

# Saved plan files (from terraform plan -out=...)
tfplan
*.tfplan

# Terraform crash and debug logs
crash.log
crash.*.log
*.log

# Environment files
.env
.env.*

# Editor
.vscode/

# SSH keys and certificates
asip_key*
*.pem
*.key
*.ppk
id_*